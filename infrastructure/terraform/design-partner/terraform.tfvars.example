aws_region               = "us-east-1"
domain_name              = "ai-fde.example.com"
route53_zone_id           = "Z0000000000000000000"
acm_certificate_arn       = "arn:aws:acm:us-east-1:000000000000:certificate/replace-me"
web_image                 = "000000000000.dkr.ecr.us-east-1.amazonaws.com/ai-fde-design-partner/web@sha256:replace-with-64-lowercase-hex"
api_image                 = "000000000000.dkr.ecr.us-east-1.amazonaws.com/ai-fde-design-partner/api@sha256:replace-with-64-lowercase-hex"
worker_image              = "000000000000.dkr.ecr.us-east-1.amazonaws.com/ai-fde-design-partner/worker@sha256:replace-with-64-lowercase-hex"
release_revision          = "replace-with-exact-40-character-lowercase-git-sha"
deployment_id             = "replace-with-deployment-record-id"
worker_operator_id        = "00000000-0000-4000-8000-000000000002"
worker_engagement_id      = null # set one nonzero canonical UUID before enabling sanitized data
bedrock_model_id          = "replace-with-evaluated-foundation-model-id"
bedrock_model_arn         = "arn:aws:bedrock:us-east-1::foundation-model/replace-me"
bedrock_allowed_data_classifications = ["PUBLIC", "INTERNAL"]
oidc_issuer_url           = "https://replace-me.us.auth0.com/"
oidc_client_id            = "replace-me"
oidc_allowed_emails       = ["fde@example.com"]
deployment_principal_arn  = "arn:aws:iam::000000000000:role/replace-with-federated-ci-role"
qualification_principal_arn = "arn:aws:iam::000000000000:role/replace-with-independent-qualifier"
evidence_principal_arn    = "arn:aws:iam::000000000000:role/replace-with-independent-evidence-reviewer"
migration_principal_arn   = "arn:aws:iam::000000000000:role/replace-with-migration-broker-caller"
# First deployment. On rotation, use the sorted exact role ARN(s) retained by
# the quarantine handoff procedure.
prior_worker_task_role_arns = []
package_retrieval_target_secret_arn = null
package_retrieval_target_kms_key_arn = null
services_enabled          = false
sanitized_data_enabled    = false
pending_qualification_record_version_id = null # migration binding stage only
active_qualification_record_version_id  = null # set equal to pending only at activation
api_runtime_secret_version_id           = "replace-with-api-secret-version-id"
migration_runtime_secret_version_id     = "replace-with-migration-secret-version-id"
alarm_topic_arn           = null
backup_event_topic_arn    = null
