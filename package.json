{
  "name": "ai-fde",
  "private": true,
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "scripts": {
    "dev": "concurrently --kill-others --names api,worker,web --prefix-colors blue,magenta,green \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "PYTHONPATH=src uv run uvicorn apps.api.main:app --reload --port 8000 --no-access-log",
    "dev:worker": "AI_FDE_WORKER_HEARTBEAT_ENABLED=false PYTHONPATH=src uv run python -m ai_fde.worker",
    "dev:web": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "lint": "pnpm --dir apps/web lint",
    "test": "pnpm --dir apps/web test",
    "typecheck": "pnpm --dir apps/web typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
