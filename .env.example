AI_FDE_ENV=development
AI_FDE_RUNTIME_ROLE=api
AI_FDE_AUTH_MODE=development
AI_FDE_DATABASE_URL=postgresql+psycopg://ai_fde_app:ai_fde_app@localhost:55432/ai_fde
AI_FDE_MIGRATION_DATABASE_URL=postgresql+psycopg://ai_fde_owner:ai_fde_owner@localhost:55432/ai_fde
AI_FDE_DATABASE_CONNECT_TIMEOUT_SECONDS=5
AI_FDE_OPERATOR_ID=00000000-0000-4000-8000-000000000001
AI_FDE_OPERATOR_SUBJECT=local-founder
AI_FDE_OPERATOR_NAME=Local FDE
# Required in production; provision with ai-fde-admin provision-worker.
# AI_FDE_WORKER_OPERATOR_ID=00000000-0000-4000-8000-000000000002
AI_FDE_COCKPIT_URL=http://localhost:3000
# Auth0 Regular Web Application settings (required when AI_FDE_AUTH_MODE=oidc)
# AI_FDE_OIDC_ISSUER_URL=https://your-tenant.us.auth0.com/
# AI_FDE_OIDC_CLIENT_ID=your-client-id
# AI_FDE_OIDC_CLIENT_SECRET=your-client-secret
# AI_FDE_OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback
# AI_FDE_OIDC_ALLOWED_EMAILS=["fde@example.com"]
# AI_FDE_OIDC_REQUEST_TIMEOUT_SECONDS=10
# AI_FDE_OIDC_LOGIN_TTL_SECONDS=600
AI_FDE_SESSION_COOKIE_NAME=ai_fde_session
AI_FDE_SESSION_TTL_SECONDS=43200
AI_FDE_ALLOWED_ORIGINS=["http://localhost:3000"]
AI_FDE_S3_ENDPOINT_URL=http://localhost:59000
AI_FDE_S3_ACCESS_KEY=ai-fde-dev
AI_FDE_S3_SECRET_KEY=ai-fde-dev-secret
AI_FDE_S3_BUCKET=ai-fde-evidence
AI_FDE_S3_REGION=us-east-1
AI_FDE_S3_USE_WORKLOAD_IDENTITY=false
# Deterministic extraction is restricted to synthetic development and tests.
AI_FDE_EXTRACTION_PROVIDER=deterministic
# Required when AI_FDE_EXTRACTION_PROVIDER=bedrock
# AI_FDE_BEDROCK_MODEL_ID=your-version-pinned-model-or-inference-profile-id
AI_FDE_BEDROCK_REGION=us-east-1
AI_FDE_BEDROCK_CONNECT_TIMEOUT_SECONDS=10
AI_FDE_BEDROCK_READ_TIMEOUT_SECONDS=240
AI_FDE_BEDROCK_MAX_ATTEMPTS=3
AI_FDE_BEDROCK_MAX_OUTPUT_TOKENS=4096
# Per-job hard stops are checked before any extraction provider call.
AI_FDE_EXTRACTION_MAX_SEGMENTS_PER_JOB=100
AI_FDE_EXTRACTION_MAX_PROVIDER_CALLS_PER_JOB=50
AI_FDE_EXTRACTION_MAX_PROVIDER_TOKENS_PER_JOB=1000000
# Stable server-controlled issuer identity embedded in deployment packages.
AI_FDE_FACTORY_ENGINEER_ISSUER_ID=factory-engineer-local
AI_FDE_WORKER_POLL_SECONDS=1
# Must exceed the Bedrock read timeout by at least 30 seconds.
AI_FDE_WORKER_LEASE_SECONDS=300
# Sanitized data remains fail-closed until a signed deployment validation exists.
AI_FDE_SANITIZED_DATA_ENABLED=false
# AI_FDE_DEPLOYMENT_VALIDATION_ID=design-partner-readiness-YYYY-MM-DD
NEXT_PUBLIC_AI_FDE_API_URL=http://localhost:8000/api
