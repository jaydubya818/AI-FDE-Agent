AI_FDE_ENV=development
AI_FDE_AUTH_MODE=development
AI_FDE_DATABASE_URL=postgresql+psycopg://ai_fde_app:ai_fde_app@localhost:55432/ai_fde
AI_FDE_MIGRATION_DATABASE_URL=postgresql+psycopg://ai_fde_owner:ai_fde_owner@localhost:55432/ai_fde
AI_FDE_DATABASE_CONNECT_TIMEOUT_SECONDS=5
AI_FDE_OPERATOR_ID=00000000-0000-4000-8000-000000000001
AI_FDE_OPERATOR_SUBJECT=local-founder
AI_FDE_OPERATOR_NAME=Local FDE
AI_FDE_COCKPIT_URL=http://localhost:3000
# Auth0 Regular Web Application settings (required when AI_FDE_AUTH_MODE=oidc)
# AI_FDE_OIDC_ISSUER_URL=https://your-tenant.us.auth0.com/
# AI_FDE_OIDC_CLIENT_ID=your-client-id
# AI_FDE_OIDC_CLIENT_SECRET=your-client-secret
# AI_FDE_OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback
# AI_FDE_OIDC_ALLOWED_EMAILS=["fde@example.com"]
# AI_FDE_OIDC_REQUEST_TIMEOUT_SECONDS=10
# AI_FDE_OIDC_LOGIN_TTL_SECONDS=600
AI_FDE_SESSION_COOKIE_NAME=ai_fde_session
AI_FDE_SESSION_TTL_SECONDS=43200
AI_FDE_ALLOWED_ORIGINS=["http://localhost:3000"]
AI_FDE_S3_ENDPOINT_URL=http://localhost:59000
AI_FDE_S3_ACCESS_KEY=ai-fde-dev
AI_FDE_S3_SECRET_KEY=ai-fde-dev-secret
AI_FDE_S3_BUCKET=ai-fde-evidence
AI_FDE_S3_REGION=us-east-1
NEXT_PUBLIC_AI_FDE_API_URL=http://localhost:8000/api
